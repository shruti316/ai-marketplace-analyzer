# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Windows-specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary file types that should never undergo line ending normalization
*.joblib binary
*.npz binary
*.npy binary
*.parquet binary
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar.gz binary
