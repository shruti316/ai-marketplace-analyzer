# AI-Powered Indian Marketplace Trust Intelligence Platform
# Environment Configuration Template (.env.example)
# Copy to .env and customize for local development

# ------------------------------------------------------------------------------
# Runtime & Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# ------------------------------------------------------------------------------
# Python Inference Service Configuration
# ------------------------------------------------------------------------------
SERVICE_PORT=8000
SERVICE_HOST=127.0.0.1
DEFAULT_MODEL_VERSION=v1.0

# ------------------------------------------------------------------------------
# Dataset & Model Artifact Paths (Relative to repository root)
# ------------------------------------------------------------------------------
DATASET_DIR=data/indian_marketplace_trust_dataset_v1_7
MODEL_V1_0_PATH=models/advanced_multimodal_gated_model.joblib
MODEL_V1_1_PATH=models/v1_1/advanced_multimodal_gated_model_v1_1.joblib

# ------------------------------------------------------------------------------
# Planned Phase 3 Backend Integration Placeholders (Not currently active)
# ------------------------------------------------------------------------------
# DATABASE_URL=mysql://user:password@localhost:3306/marketplace_trust
# NODE_BACKEND_PORT=5000
# JWT_SECRET=change_this_in_production
