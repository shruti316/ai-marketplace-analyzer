# AI-Powered Indian Marketplace Trust Intelligence Platform
# Backend Environment Configuration Template (.env.example)
# Copy this file to .env and configure your local development values.
# NEVER commit .env to version control.

# Application Server Configuration
NODE_BACKEND_PORT=5000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET=your_minimum_32_character_jwt_and_session_signing_secret_here

# MySQL 8.0 Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=marketplace_app
DB_PASSWORD=your_secure_password_here
DB_NAME=marketplace_trust_intelligence

# Dedicated Migration Credentials (Required for schema migration runner)
MIGRATION_DB_USER=marketplace_migrator
MIGRATION_DB_PASSWORD=your_separate_secure_password_here

# Python Trust Intelligence ML Inference Service
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# Proxy Trust Configuration (set to true or number of hops if behind Nginx/ALB/Cloudflare)
TRUST_PROXY=false

# Rate Limiting Controls
AUTH_RATE_LIMIT=10
INFERENCE_RATE_LIMIT=30
HEAVY_OPS_RATE_LIMIT=40

# Upstream Python Engine Timeout Configuration (in milliseconds)
PYTHON_FAST_TIMEOUT_MS=5000
PYTHON_STANDARD_TIMEOUT_MS=10000
PYTHON_INFERENCE_TIMEOUT_MS=45000
