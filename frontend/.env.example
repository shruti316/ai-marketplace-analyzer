# AI Marketplace Analyzer - Frontend Environment Configuration Example
# Copy to frontend/.env for local development
# In Vercel Project Settings > Environment Variables:
#   Set VITE_API_BASE_URL to your deployed Render backend URL (e.g., https://your-backend.onrender.com)

# Base URL for the Express API
# Local dev: http://127.0.0.1:5000 (or leave empty to use Vite /api proxy)
# Vercel Production: https://your-render-backend.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:5000

# Application Environment Mode ('development' | 'production')
VITE_APP_ENV=development
